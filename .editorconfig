# Generated by Cinch from `[editor]` in the Cinch config. Do not edit this file:
# `cinch doctor --fix` rewrites it.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
