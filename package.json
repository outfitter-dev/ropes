{
  "name": "outfitter-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace for the outfitter CLI (Fit) and @outfitter/cinch.",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "bootstrap": "bash scripts/bootstrap.sh",
    "build:binary": "bun packages/cinch/scripts/build-binary.ts",
    "check": "bun run cinch check && bun run test",
    "cinch": "bun packages/cinch/src/cli.ts",
    "fix": "bun run cinch fix",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "lefthook": "2.2.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "tsrs": "7.1.0-beta.tsrs3",
    "typescript": "7.0.2",
    "ultracite": "8.1.1"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": []
}
